properties:
  file.name:
    displayName: Task
  note.Status:
    displayName: Status
  note.Due Date:
    displayName: Due Date
  note.Priority:
    displayName: Priority
  note.Effort:
    displayName: Effort (min)
  note.Booked ?:
    displayName: Booked ?
views:
  - type: tasknotesKanban
    name: Board
    filters:
      and:
        - file.hasTag("Task")
    groupBy:
      property: Status
      direction: ASC
    order:
      - file.name
      - Status
      - Due Date
      - Priority
      - Effort
      - Booked ?
      - Project
      - Stakeholders
    options:
      columnWidth: 280
      hideEmptyColumns: false
