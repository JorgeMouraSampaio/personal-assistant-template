formulas:
  Initiative: if(note.Initiative, note.Initiative, if(file(note.Project), file(note.Project).properties.Initiative, ""))
properties:
  file.name:
    displayName: Title
  note.Task Number:
    displayName: Task
  note.Status:
    displayName: Status
  note.Project:
    displayName: Project
  note.Initiative:
    displayName: Initiative
  formula.Initiative:
    displayName: Initiative
  note.Stakeholders:
    displayName: Stakeholders
  note.Company:
    displayName: Company
  note.Created Date:
    displayName: Created Date
  note.Due Date:
    displayName: Due Date
  note.Priority:
    displayName: Priority
  note.Effort:
    displayName: Effort (min)
  note.Booked ?:
    displayName: Booked ?
  note.Notes:
    displayName: Notes
  note.Links:
    displayName: Links
views:
  - type: table
    name: Table
    filters:
      and:
        - file.hasTag("Task")
    order:
      - Task Number
      - file.name
      - Status
      - Project
      - formula.Initiative
      - Created Date
      - Due Date
      - Priority
      - Effort
      - Booked ?
      - Stakeholders
      - Company
      - Notes
      - Links
    sort:
      - property: Task Number
        direction: ASC
      - property: formula.Initiative
        direction: ASC
    columnSize:
      note.Task Number: 106
      file.name: 457
  - type: tasknotesKanban
    name: Project Board
    filters:
      and:
        - file.hasTag("Task")
        - file.hasLink(this.file)
    groupBy:
      property: Status
      direction: ASC
    order:
      - file.name
      - Status
      - Due Date
      - Priority
      - Effort
      - Booked ?
      - Stakeholders
    options:
      columnWidth: 260
      hideEmptyColumns: false
  - type: table
    name: Project Table
    filters:
      and:
        - file.hasTag("Task")
        - file.hasLink(this.file)
    order:
      - file.name
      - Task Number
      - Status
      - Due Date
      - Priority
      - Effort
      - Booked ?
      - Stakeholders
    sort:
      - property: Task Number
        direction: ASC
  - type: table
    name: Initiative Table
    filters:
      and:
        - file.hasTag("Task")
        - note.Initiative == this
        - note.Status != "Discarded"
    groupBy:
      property: Status
      direction: ASC
    order:
      - file.name
      - Task Number
      - Status
      - Due Date
      - Priority
      - Effort
      - Booked ?
      - Stakeholders
    sort:
      - property: Due Date
        direction: ASC
