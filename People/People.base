properties:
  file.name:
    displayName: Name
views:
  - type: table
    name: Table
    filters:
      and:
        - file.hasTag("People")
    order:
      - file.name
      - Company
      - Division
      - Role
      - Email
      - LinkedIn
      - Notes
    sort:
      - property: Company
        direction: ASC
      - property: file.name
        direction: ASC
    columnSize:
      file.name: 203
      note.Division: 142
      note.Role: 153
      note.LinkedIn: 136
