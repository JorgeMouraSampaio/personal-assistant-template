properties:
  file.name:
    displayName: Name
views:
  - type: table
    name: Table
    filters:
      and:
        - file.hasTag("People")
    order:
      - file.name
      - Company
      - Division
      - Role
      - Email
      - LinkedIn
      - Notes
    sort:
      - property: Company
        direction: ASC
      - property: file.name
        direction: ASC
    columnSize:
      note.Role: 131
